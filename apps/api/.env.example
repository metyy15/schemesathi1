# SchemeSathi API Environment Variables
# Copy to .env and fill values

# App
APP_NAME=SchemeSathi
ENVIRONMENT=development
SECRET_KEY=change-this-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/schemesathi

# TinyFish
TINYFISH_API_KEY=sk-tinyfish-Ee6okripXa8DLjslLHZKtNEPb_CVC7Jl
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# LLM (optional)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# OCR
OCR_ENGINE=tesseract  # tesseract or cloud
TESSERACT_CMD=

# Storage (private)
STORAGE_BACKEND=local  # local or s3
LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Notifications (optional)
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# Monitoring
ENABLE_SCHEDULER=false
